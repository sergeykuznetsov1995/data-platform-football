-- silver.fotmob_competition_season_history — одна строка истории победителей турнира (#2018, эпик #1677).
-- Схема-истина: configs/medallion/fotmob_silver/core_schema.yaml
-- (tables.fotmob_competition_season_history) + README.
-- Глобальная таблица (context_as_key): без партиций, ключ — (competition_id, history_season_label);
-- метка — как в seasons[] страницы турнира, это не ключ сезона FotMob.
-- competition_id в bronze — varchar: приводится к BIGINT один раз на входе; пустой/неприводимый
-- ключ -> строка отбрасывается.
-- Pure SELECT: CREATE OR REPLACE добавляет раннер.
-- Заполнитель fotmob_season_scope (отдельная строка) — булево выражение над competition_id (BIGINT)
-- и source_season_key (VARCHAR); у этой таблицы ключа сезона нет, source_season_key здесь всегда
-- NULL, поэтому скоуп задаётся по турниру; полный прогон — TRUE.
WITH
src AS (
    SELECT *
    FROM (
        SELECT
            TRY_CAST(competition_id AS BIGINT) AS competition_id,
            CAST(NULL AS VARCHAR) AS source_season_key,
            history_season_label, winner_id, winner_name, runner_up_id, runner_up_name,
            season_history_json,
            _target_batch_id, _observed_at, _ingested_at, _parser_version
        FROM iceberg.bronze.fotmob_competition_season_history_current
    ) s
    WHERE competition_id IS NOT NULL
      AND history_season_label IS NOT NULL
      AND history_season_label <> ''
      AND (
        {{ fotmob_season_scope }}
      )
),
dedup AS (
    SELECT *
    FROM (
        SELECT
            s.*,
            ROW_NUMBER() OVER (
                PARTITION BY competition_id, history_season_label
                ORDER BY _observed_at DESC, _ingested_at DESC
            ) AS rn
        FROM src s
    ) d
    WHERE rn = 1
)
SELECT
    d.competition_id,
    d.history_season_label,
    d.winner_id AS winner_team_id,
    d.winner_name AS winner_team_name,
    d.runner_up_id AS runner_up_team_id,
    d.runner_up_name AS runner_up_team_name,
    NULLIF(d.season_history_json, 'null') AS season_history_json,
    d._target_batch_id AS _bronze_batch_id,
    d._observed_at AS _bronze_observed_at,
    d._ingested_at AS _bronze_ingested_at,
    d._parser_version,
    CAST(NULL AS VARCHAR) AS _conform_issues_json
FROM dedup d
