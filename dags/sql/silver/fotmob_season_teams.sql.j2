-- silver.fotmob_season_teams — одна команда-участник сезона (#2018, эпик #1677).
-- Схема-истина: configs/medallion/fotmob_silver/core_schema.yaml (tables.fotmob_season_teams) + README.
-- Ключ (competition_id, source_season_key, team_id); ключ сезона — тот, под которым команду отдал
-- FotMob. Пустой/неприводимый ключ -> строка отбрасывается.
-- scope_stage_ids — отсортированный массив различных непустых scope_stage_id всех строк ключа
-- (отдельный подзапрос, JOIN 1:1 к выбранной строке); стадий нет -> NULL.
-- Pure SELECT: CREATE OR REPLACE / партиции (competition_id, source_season_key) добавляет раннер.
-- Заполнитель fotmob_season_scope (отдельная строка) — булево выражение над competition_id (BIGINT)
-- и source_season_key (VARCHAR); полный прогон — TRUE.
WITH
src AS (
    SELECT *
    FROM (
        SELECT
            TRY_CAST(competition_id AS BIGINT) AS competition_id,
            source_season_key, team_id, team_name, team_short_name, scope_stage_id,
            team_name_variants, team_short_name_variants, source_paths,
            _target_batch_id, _observed_at, _ingested_at, _parser_version
        FROM iceberg.bronze.fotmob_season_teams_current
    ) s
    WHERE competition_id IS NOT NULL
      AND source_season_key IS NOT NULL
      AND source_season_key <> ''
      AND team_id IS NOT NULL
      AND (
        {{ fotmob_season_scope }}
      )
),
dedup AS (
    SELECT *
    FROM (
        SELECT
            s.*,
            ROW_NUMBER() OVER (
                PARTITION BY competition_id, source_season_key, team_id
                ORDER BY _observed_at DESC, _ingested_at DESC
            ) AS rn
        FROM src s
    ) d
    WHERE rn = 1
),
stage_ids AS (
    SELECT
        competition_id,
        source_season_key,
        team_id,
        array_sort(array_agg(DISTINCT scope_stage_id)) AS scope_stage_ids
    FROM src
    WHERE scope_stage_id IS NOT NULL
    GROUP BY competition_id, source_season_key, team_id
)
SELECT
    d.competition_id,
    d.source_season_key,
    d.team_id,
    d.team_name,
    d.team_short_name,
    g.scope_stage_ids,
    NULLIF(d.team_name_variants, 'null') AS team_name_variants_json,
    NULLIF(d.team_short_name_variants, 'null') AS team_short_name_variants_json,
    NULLIF(d.source_paths, 'null') AS source_paths_json,
    d._target_batch_id AS _bronze_batch_id,
    d._observed_at AS _bronze_observed_at,
    d._ingested_at AS _bronze_ingested_at,
    d._parser_version,
    CAST(NULL AS VARCHAR) AS _conform_issues_json
FROM dedup d
LEFT JOIN stage_ids g
  ON g.competition_id = d.competition_id
 AND g.source_season_key = d.source_season_key
 AND g.team_id = d.team_id
