# Separate deployment env; never commit real secrets. Both tokens >=32 chars and distinct.
# Use an image WITHOUT a baked-in WhoScored runtime anchor; ws954 exits 78.
# Lead-verified reference: data-platform-airflow-scheduler:fbref-590579ef…
# image ID sha256:5286d9cf18bf… (resolve the full digest before deployment).
CLUBELO_GATEWAY_IMAGE=registry.example/gateway@sha256:REPLACE_WITH_VERIFIED_DIGEST
CLUBELO_RELEASE_ROOT=/srv/clubelo/releases/REPLACE_WITH_SHA
CLUBELO_GATEWAY_STATE_HOST_DIR=/srv/clubelo/gateway-state
PROXY_POOL_JSON=
PROXY_FILTER_CONTROL_TOKEN=
CLUBELO_PROXY_CONTROL_TOKEN=
PROXY_FILTER_CLUBELO_DAGRUN_BUDGET_BYTES=33554432
PROXY_FILTER_CLUBELO_HISTORY_DAGRUN_BUDGET_BYTES=134217728
PROXY_FILTER_DAILY_BUDGET_MB=4096
CLUBELO_GATEWAY_MAX_LEASE_MB=128
CLUBELO_GATEWAY_URL_BUDGET_BYTES=134217728
CLUBELO_PROXY_TTL_SECONDS=3600
# Collector defaults (no scheduler recreation needed):
# CLUBELO_PROXY_CONTROL_URL=http://clubelo_proxy_filter:8899
# CLUBELO_PROXY_CONTROL_TOKEN_FILE=/opt/airflow/configs/proxy_filter/clubelo_control_token
# CLUBELO_FLARESOLVERR_URL=http://flaresolverr:8191
# CLUBELO_PROXY_MAX_BYTES=33554432
# CLUBELO_PROXY_HISTORY_MAX_BYTES=134217728
