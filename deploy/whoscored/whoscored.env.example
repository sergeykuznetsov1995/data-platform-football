# Переменные compose контура WhoScored (airflow.compose.yaml, gw.compose.yaml) — ТОЛЬКО имена.
# Значения живут в --env-file (сейчас /root/data-platform-football/.env, общий с платформой);
# сюда их не писать. Пустые строки ниже = «задать в env-файле».

# --- пути хоста (необязательные: без них — значения по умолчанию из compose)
# WHOSCORED_RUNTIME_DIR=/root/whoscored-1017-runtime
# WHOSCORED_PROXY_HOST_FILE=/root/dpf-whoscored-merge/proxys.txt

# --- Airflow контура (своя metadata-DB whoscored-airflow-metadb)
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_DB_PASSWORD=
AIRFLOW__WEBSERVER__SECRET_KEY=
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=

# --- Trino (сеть dp-storage)
TRINO_PORT=
TRINO_USER=
TRINO_PASSWORD=

# --- S3 / Iceberg
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
ICEBERG_WAREHOUSE=
ICEBERG_REST_WAREHOUSE=
ICEBERG_REST_URI=

# --- алерты DAG (необязательные)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
