# Env-файл контура Transfermarkt (проекты transfermarkt-airflow и transfermarkt-gw,
# скрипты deploy/transfermarkt/, #1387). Скопировать в /etc/data-platform/transfermarkt.env
# (root:root, 0600) и заполнить; передаётся ВТОРЫМ --env-file после общего .env
# платформы, из которого берутся AIRFLOW__CORE__FERNET_KEY, AIRFLOW__WEBSERVER__SECRET_KEY,
# TRINO_PORT/TRINO_PASSWORD, S3_*, PROXY_FILTER_CONTROL_TOKEN, TM_NATIVE_V2_ENABLED,
# TM_STANDING_POLICY_ENABLED, TM_REQUIRE_METERED_PROXY, TELEGRAM_*, _AIRFLOW_WWW_USER_*.
# Принимаются только ключи TRANSFERMARKT_* и TM_* (env.sh). Ни одно значение не коммитится.
#
# Раскладка runtime-каталога (вне git, переживает ротации релиза):
#   <runtime>/logs/            /opt/airflow/logs планировщика: логи задач и состояние TM
#                              (transfermarkt-approvals, -registry, -native-v2, -checkpoints,
#                              -traffic, -backfill); владелец uid 50000
#   <runtime>/gateway-state/   леджер, разрешения и счётчики шлюза; владелец uid 50000
#   <runtime>/auto-deliver/    состояние автомата ночной доставки (root, 0700)
#   <runtime>/deploy.log       журнал deploy.sh
#   <runtime>/proxy-pool.decodo.json   пул Decodo шлюза (секрет, 0600)

# --- Источник, деревья, образы -------------------------------------------------------
TRANSFERMARKT_SOURCE_REPO=https://github.com/sergeykuznetsov1995/data-platform-football.git
# freeze_release.sh создаёт <dir>/release-<gitsha8>.
TRANSFERMARKT_RELEASES_DIR=/opt/transfermarkt/releases
# Текущее замороженное дерево (bind-mount обоих проектов). Меняет deploy.sh.
TRANSFERMARKT_RELEASE_ROOT=/opt/transfermarkt/releases/release-00000000
# Пинованный образ (тот же, на котором живёт sofascore-airflow-scheduler); шлюз — на нём же.
TRANSFERMARKT_AIRFLOW_IMAGE=data-platform-airflow-scheduler:<pinned-tag>
TRANSFERMARKT_POSTGRES_IMAGE=postgres:16-alpine

# --- Runtime и секреты контура --------------------------------------------------------
TRANSFERMARKT_RUNTIME_DIR=/root/transfermarkt-runtime
# Свой пароль метабазы (openssl rand -hex 24).
TRANSFERMARKT_AIRFLOW_DB_PASSWORD=
# Контрольный токен шлюза для класса transfermarkt (≥ 32 символов, openssl rand -hex 32).
# Обязан отличаться от PROXY_FILTER_CONTROL_TOKEN общего .env — иначе шлюз отказывает.
TM_PROXY_CONTROL_TOKEN=
# Класс backfill: пустой токен = класс выключен (backfill в контуре на паузе).
# TM_BACKFILL_PROXY_CONTROL_TOKEN=
# Файл пула Decodo; deploy.sh читает его в окружение процесса compose (не в лог).
# Сам JSON сюда НЕ кладётся.
TRANSFERMARKT_PROXY_POOL_FILE=/root/transfermarkt-runtime/proxy-pool.decodo.json
# Общий .env платформы (первый --env-file).
TRANSFERMARKT_PLATFORM_ENV_FILE=/root/data-platform-football/.env

# --- Автомат ночной доставки -----------------------------------------------------------
# Каталог состояния НЕ создаётся сам: там замок, снимок отката, защёлка и выключатель .off.
TRANSFERMARKT_AUTO_STATE_DIR=/root/transfermarkt-runtime/auto-deliver
TRANSFERMARKT_AUTO_LOG=/root/transfermarkt-runtime/auto-deliver/auto_deliver.log
# Файл с TELEGRAM_BOT_TOKEN и TELEGRAM_CHAT_ID для алертов автомата.
TRANSFERMARKT_TG_ENV=/root/.claude/telegram.env
# Необязательный: без него замок выката — ${TRANSFERMARKT_RUNTIME_DIR}/deploy.lock.
# TRANSFERMARKT_DEPLOY_LOCK=/root/transfermarkt-runtime/deploy.lock
