# Env-файл контура FotMob (проект fotmob-airflow, автомат доставки и сторож окна в
# deploy/fotmob/). Скопировать в /etc/data-platform/fotmob.env (root:root, 0600) и
# заполнить; compose получает его ВТОРЫМ --env-file после общего .env платформы, из
# которого берутся AIRFLOW__CORE__FERNET_KEY, AIRFLOW__WEBSERVER__SECRET_KEY, TRINO_*,
# S3_*, ICEBERG_WAREHOUSE, TELEGRAM_*, _AIRFLOW_WWW_USER_*. Скрипты читают ТОЛЬКО этот
# файл (deploy/fotmob/env.sh: ключи FOTMOB_*, без подстановок и без export).
# Ни одно значение отсюда не коммитится.
#
# Три группы ключей: рецепт контура (compose), установка автомата (пути этой машины),
# пины выката (меняются каждой доставкой — «поднять пин» = переписать их здесь
# атомарно, write + chown root:root + chmod 0600 + mv, вне окна 19:45–23:20 UTC;
# скрипты больше не правятся).
# Формат — как у compose --env-file, но строже: значения без `$` (подстановок) и без
# inline-комментариев ` #`, пути без хвостового `/` (загрузчик env.sh такое отвергает,
# чтобы compose и скрипты не прочли один файл по-разному).

# --- Рецепт контура (compose) ------------------------------------------------------
# Боевое дерево: git-worktree, которое автомат переставляет
# `git checkout -B deploy/fotmob-b6-master <FOTMOB_TARGET>` под живыми bind-mount'ами
# (только checkout внутри того же каталога — rsync/mv/rm меняют инод каталога).
FOTMOB_RELEASE_ROOT=/durable/path/fotmob-release-tree
# Пинованный образ scheduler/init/webserver (у живого контура — образ fbref-590579ef…).
FOTMOB_AIRFLOW_IMAGE=data-platform-airflow-scheduler:<pinned-tag>
# Метабаза контура: живое значение postgres:16-alpine; лучше запинить digest.
FOTMOB_POSTGRES_IMAGE=postgres:16-alpine
# Пароль метабазы контура. База инициализирована 2026-07-17 значением общего
# AIRFLOW_DB_PASSWORD того дня — при переезде на этот рецепт сюда идёт именно оно.
FOTMOB_AIRFLOW_DB_PASSWORD=
# Хостовая копия deploy/fotmob/isolated.airflowignore — file-bind в
# /opt/airflow/dags/.airflowignore. Живёт ВНЕ дерева (дерево переставляет checkout, а
# file-bind держит инод). Обновлять только append'ом (`>>`) или `cp` поверх — не mv.
FOTMOB_DAGBAG_IGNORE_FILE=/durable/path/fotmob-runtime/airflowignore-fotmob.v2
# Общий .env платформы (первый --env-file).
FOTMOB_PLATFORM_ENV_FILE=/durable/path/data-platform-football/.env

# --- Установка автомата доставки (пути этой машины) --------------------------------
# auto_deliver.sh, b6_deliver.sh, window_alert.sh и env.sh ставятся в ОДИН каталог
# (например /usr/local/libexec/fotmob/): автомат зовёт b6_deliver.sh по соседству.
# Каталог кампании истории (driver.sh, state/, logs/) — автомат поднимает её после
# принятой доставки и гасит при откате.
FOTMOB_CAMPAIGN_DIR=/durable/path/fotmob_history_backfill
# Каталог состояния автомата: замок (fotmob-auto-deliver.lock), маркеры, защёлки,
# очередь алертов, выключатель fotmob-auto-deliver.off. Существовать обязан заранее —
# автомат его не создаёт (потеря каталога = потеря маркеров доставки).
FOTMOB_STATE_DIR=/durable/path/watchdog/state
# Собственный лог автомата (в него же уходит вывод b6_deliver.sh apply).
FOTMOB_LOG=/durable/path/watchdog/fotmob_auto_deliver.log
# Имена контейнеров контура (совпадают с container_name в isolated.compose.yaml).
FOTMOB_METADB_CONTAINER=fotmob-airflow-metadb
FOTMOB_SCHEDULER_CONTAINER=fotmob-airflow-scheduler
# Файл с TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID для алертов автомата (секрет, 0600).
FOTMOB_TG_ENV=/durable/path/telegram.env
# Скрипт-отправитель алерта сторожа окна (получает текст первым аргументом).
FOTMOB_TG_HOOK=/usr/local/libexec/tg-send
# pytest venv'а с зависимостями репозитория: b6_deliver.sh гоняет быстрый сьют на дереве.
FOTMOB_HOST_PYTEST=/path/to/venv/bin/pytest

# --- Пины выката (меняются каждой доставкой) ----------------------------------------
# ВСЕ SHA здесь — КОРОТКИЕ (7–8 hex, как печатает `git rev-parse --short`): автомат
# сравнивает их с `--short HEAD` по префиксу, полный 40-значный SHA не совпадёт никогда
# (скрипты с ним не стартуют).
# Цель: коммит, который автомат ставит в боевое дерево в ближайшее окно.
FOTMOB_TARGET=00000000
# Откат: текущий принятый HEAD боевого дерева (ref для checkout и голый короткий SHA,
# по которому b6 сверяет HEAD).
FOTMOB_ROLLBACK_REF=00000000
FOTMOB_ROLLBACK_SHA=00000000
# Доказательство доставки: модуль, который цель меняет (путь ВНУТРИ контейнера), и его
# md5 из git цели (`git show <TARGET>:<путь в репо> | md5sum`).
FOTMOB_NEW_CODE_FILE=/opt/airflow/scrapers/fotmob/service.py
FOTMOB_NEW_CODE_MD5=00000000000000000000000000000000
