-server
# Heap = 50% of the container limit (#847, #1937): parquet/direct buffers,
# metaspace, code cache and GC live outside the heap — at 3500M/5G the RSS
# crossed the cgroup ceiling and the kernel silently killed the JVM every
# 20-50 min. 10g of 20G: six Java heap OOMs 25–28.10.2026 at -Xmx5g were
# coordinator planning memory (Iceberg manifests of ~130k-file tables), which
# memory.heap-headroom-per-node must cover — see config.properties.
-Xmx10g
-XX:G1HeapRegionSize=32M
-XX:+ExplicitGCInvokesConcurrent
-XX:+ExitOnOutOfMemoryError
-XX:+HeapDumpOnOutOfMemoryError
-XX:-OmitStackTraceInFastThrow
-XX:ReservedCodeCacheSize=128M
-XX:PerMethodRecompilationCutoff=10000
-XX:PerBytecodeRecompilationCutoff=10000
-Djdk.attach.allowAttachSelf=true
-Djdk.nio.maxCachedBufferSize=2000000
-Dfile.encoding=UTF-8
-XX:+UnlockDiagnosticVMOptions
-XX:+UseAESCTRIntrinsics
